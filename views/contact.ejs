<%- include('partials/head', { title: "Contact | Catalysta", description: null }) %>
<body>
<%- include('partials/header', { activePage: 'contact' }) %>
<!-- Shared site header and navigation -->


<main class="contact-page">
  <!-- Contact introduction and consultation form -->
  <section class="contact-hero">
    <div class="section-inner contact-hero-inner">
      <div class="contact-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span>Contact us</div>
        <h1 class="hero-title contact-title">Let’s build what’s next.</h1>
        <p class="hero-text contact-intro">Tell us what you’re solving, where you want to grow, and what momentum looks like for your next chapter. We’ll help you turn complexity into clarity.</p>
        <div class="contact-map">
          <iframe
            src="https://www.google.com/maps?q=PSE%20Tower%2C%205th%20Avenue%20corner%2028th%20Street%2C%20BGC%201634%2C%20Taguig%2C%20Metro%20Manila%2C%20Philippines&amp;z=16&amp;output=embed"
            title="Map showing PSE Tower in Taguig"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen>
          </iframe>
        </div>
      </div>

      <div class="contact-card">
        <h2>Book a consultation</h2>
        <form class="contact-form" id="contactForm" action="https://formsubmit.co/gianjer008@gmail.com" method="POST">
          <div class="form-row">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" placeholder="Your name" required>
          </div>
          <div class="form-row">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@company.com" required>
          </div>
          <div class="form-row">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" placeholder="Company name">
          </div>
          <div class="form-row">
            <label for="service">Service</label>
            <select id="service" name="service">
              <option>Business Review</option>
              <option>Business Proposal</option>
              <option>Managing Human Capital</option>
              <option>General enquiry</option>
            </select>
          </div>
          <div class="form-row">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="5" placeholder="Tell us about your challenge or opportunity" required></textarea>
          </div>
          <button type="submit" class="btn btn-pill btn-maroon">Send Enquiry <span class="arrow">↗</span></button>
        </form>
      </div>
    </div>
  </section>

  <!-- Office address, email, and phone details -->
  <section class="contact-details">
    <div class="section-inner contact-grid">
      <div class="detail-panel">
        <h3>Connect with us</h3>
        <div class="detail-item">
          <i class='bx bx-map'></i>
          <span>PSE Tower, 5th Avenue corner 28th Street, BGC 1634, Taguig, Metro Manila, Philippines</span>
        </div>
        <div class="detail-item">
          <i class='bx bx-envelope'></i>
          <span>hello@catalysta.co</span>
        </div>
        <div class="detail-item">
          <i class='bx bx-phone'></i>
          <span>(+63) 995 069 6769</span>
        </div>
      </div>
    </div>
  </section>
</main>

<!-- ===================== FOOTER ===================== -->
<%- include('partials/footer') %>
<script src="/JS/script.js" defer></script>
</body>
</html>
