<%- include('partials/head', { title: "Catalysta | Business Consultancy", description: null }) %>
<body>
<%- include('partials/header', { activePage: 'home' }) %>
<!-- ===================== NAVBAR ===================== -->


<!-- ===================== HERO ===================== -->
<section class="hero" id="home">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <h1 class="hero-title">Make the next move matter.</h1>
    <p class="hero-subtitle">Agent for Growth</p>
    <p class="hero-text">“Your agent of growth” symbolizes the company’s commitment to acting as a strategic partner in driving the<br>business growth and success of its clients.</p>
    <a href="/contact" class="btn btn-pill btn-maroon">Let's talk <span class="arrow">→</span></a>
  </div>
</section>

<!-- ===================== ABOUT ===================== -->
<!-- Company overview and core values -->
<section class="about" id="about">
  <div class="section-inner about-grid">
    <div class="about-copy">
      <div class="eyebrow"><span class="eyebrow-line"></span><span class="eyebrow-text">About us</span></div>
      <h2 class="heading-maroon">More than Consultants</h2>
      <p class="heading-script">We're your Growth partner</p>
      <p class="body-text">CATALYSTA stands at the forefront of business transformation. Our role as a business management consultancy firm goes beyond providing services; we aim to be architects of our client's success. Specializing in problem identification and analysis, strategy development, process optimization, and more, we offer a holistic approach to business improvement.</p>
      <p class="body-text">Our methodology is rooted in a deep understanding of market dynamics and organizational behavior, ensuring solutions that are not only innovative but also actionable and sustainable. We partner with clients to realize their business potential and chart a path toward lasting success.</p>
      <a href="/services" class="btn btn-pill btn-maroon">Discover more <span class="arrow">↗</span></a>
    </div>
    <div class="about-media placeholder-img" aria-label="Catalysta office and meeting room photo"></div>
  </div>

  <div class="section-inner values-row">
    <div class="values-label">Our values</div>
    <div class="values-list">
      <div class="value-item">
        <div class="value-icon" aria-hidden="true">
          <i class='bx bxs-briefcase-alt-2'></i>
        </div>
        <p>Professionalism</p>
      </div>
      <div class="value-item">
        <div class="value-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.24 4.76c-2.3-2.29-5.87-2.35-8.24-.19-2.37-2.16-5.93-2.09-8.24.2-2.36 2.37-2.36 6.07 0 8.43l7.53 7.52c.2.19.45.29.71.29s.51-.1.71-.29l7.53-7.52c2.36-2.36 2.36-6.06 0-8.43ZM12 18.59l-6.82-6.81a3.92 3.92 0 0 1 0-5.6C5.97 5.39 6.98 5 7.99 5s2.02.39 2.8 1.18l.5.5-2.38 2.39c-.51.52-.51 1.36 0 1.88.49.49 1.13.73 1.77.73s1.28-.24 1.77-.73l1.64-1.64 3.59 3.59-1.04 1.04-2.3-2.3-.71.71 2.3 2.3-.79.79-2.3-2.3-.71.71 2.3 2.3-.79.79-2.29-2.29-.71.71 2.29 2.29-.94.94Zm6.82-6.81-.42.42-3.59-3.59 1.24-1.24-.71-.71-3.59 3.59c-.58.58-1.54.58-2.12 0a.33.33 0 0 1 0-.47l3.42-3.44.16-.16c1.57-1.57 4.04-1.57 5.62 0 1.57 1.58 1.57 4.04 0 5.6Z"></path>
          </svg>
        </div>
        <p>Service oriented</p>
      </div>
      <div class="value-item">
        <div class="value-icon" aria-hidden="true">
          <i class='bx bxs-wrench'></i>
        </div>
        <p>Innovative</p>
      </div>
      <div class="value-item">
        <div class="value-icon" aria-hidden="true">
          <i class='bx bxs-brain'></i>
        </div>
        <p>Knowledgeable</p>
      </div>
      <div class="value-item">
        <div class="value-icon" aria-hidden="true">
          <i class='bx bxs-bullseye'></i>
        </div>
        <p>Committed</p>
      </div>
    </div>
  </div>
</section>

<!-- ===================== SERVICES CARDS ===================== -->
<!-- Featured consultancy services -->
<section class="services" id="services">
  <div class="section-inner">
    <div class="eyebrow"><span class="eyebrow-line"></span>Services</div>
    <div class="difference-cards">
      <article class="diff-card">
        <h3><span class="diff-index">01</span><span class="diff-sep">|</span>Business Review</h3>
        <p>Assessing priorities, performance &amp; opportunities</p>
        <a href="/services#service-review" class="btn btn-pill btn-accent-soft">See more <span class="arrow">↗</span></a>
      </article>
      <article class="diff-card">
        <h3><span class="diff-index">02</span><span class="diff-sep">|</span>Business Proposal</h3>
        <p>Building clear, efficient &amp; effective workflows</p>
        <a href="/services#service-proposal" class="btn btn-pill btn-accent-soft">See more <span class="arrow">↗</span></a>
      </article>
      <article class="diff-card">
        <h3><span class="diff-index">03</span><span class="diff-sep">|</span>Managing Human Capital</h3>
        <p>Supporting people, role &amp; organizational growth</p>
        <a href="/services#service-human-capital" class="btn btn-pill btn-accent-soft">See more <span class="arrow">↗</span></a>
      </article>
    </div>
  </div>
</section>

<!-- ===================== BLOGS SECTION ===================== -->
<!-- Featured article and link to the blog library -->
<section class="blog" id="blogs">
  <div class="section-inner clarity-grid">
    <div class="clarity-media placeholder-img" aria-label="Two consultants in discussion photo"></div>
    <div class="blog-copy">
      <div class="eyebrow"><span class="eyebrow-line"></span>Blogs</div>
      <p class="card__meta card__meta--category">Style | Fashion</p>
      <h2 class="heading-maroon">The Louis Vuitton Monogram:</h2>
      <p class="heading-script">a living pattern</p>
      <p class="body-text">The story of the Louis Vuitton Monogram, unmistakable in its presence and timeless in its allure, told through three different perspectives.</p>
      <p class="card__meta card__meta--byline">By Tobias Jared Tomas · May 11, 2026</p>
      <a href="/blogs" class="btn btn-pill btn-maroon">Read more blogs <span class="arrow">↗</span></a>
    </div>
  </div>
</section>

<!-- ===================== CONTACT BANNER ===================== -->
<!-- Contact call to action -->
<section class="cta-banner">
  <div class="section-inner cta-inner">
    <div class="cta-copy">
      <h2>Have a business in mind?</h2>
      <p class="cta-text">Let's turn your visions into reality.</p>
    </div>
    <a href="/contact" class="btn btn-pill btn-accent">Work with us <span class="arrow">↗</span></a>
  </div>
</section>


<!-- ===================== FOOTER ===================== -->
<%- include('partials/footer') %>
<script src="/JS/script.js" defer></script>
</body>
</html>
